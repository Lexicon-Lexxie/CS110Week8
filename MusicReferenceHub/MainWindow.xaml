<Window x:Class="MusicReferenceHub.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Reference Hub" Width="1120" Height="850" MinWidth="900" MinHeight="780"
 Background="#071820" Foreground="#EDF8FA">
 <!-- XAML builds the visible window. C# adds the actions. Keep x:Class matched to the namespace. -->
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#EBD092"/><Setter Property="Foreground" Value="#10232C"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#F2F7F5"/><Setter Property="Foreground" Value="#10232C"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#E9F2F3"/><Setter Property="Foreground" Value="#10232C"/></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="CS110 / WEEK 8 / YOUR UTILITY" Foreground="#F1C66F"/><TextBlock Text="Music Reference Hub" FontSize="34" Margin="0,8"/>
   <!-- TODO: add your user and story context to this subtitle. -->
   <TextBlock Text="Plan the need. Build one action. Test the result." Foreground="#B5CED5"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Padding="20" BorderBrush="#315D69" BorderThickness="1" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image x:Name="imgArtwork" Stretch="Uniform"/>
    <!-- VISUAL HAT: this player opens a local file. Add behavior in C#. -->
    <MediaElement x:Name="mediaPlayer" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" LoadedBehavior="Manual" UnloadedBehavior="Stop" Volume="0.35" Stretch="Uniform" MediaOpened="Media_Opened" MediaFailed="Media_Failed" MediaEnded="Media_Ended"/>
    <TextBlock x:Name="txtNowPlaying" Grid.Row="1" Text="No local file loaded" Margin="0,12" TextWrapping="Wrap"/>
    <WrapPanel Grid.Row="2"><Button Content="Load audio" Click="Load_Click"/><Button Content="Play" Click="Play_Click"/><Button Content="Pause" Click="Pause_Click"/><Button Content="Stop" Click="Stop_Click"/></WrapPanel></Grid></Border>
   <Border Grid.Column="2" Padding="20" Background="#102A35" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- TODO: load your PNG/JPG into these named images in the Artwork chapter. -->
    <TextBlock Text="Your listening session: load a track, keep a reference, and record what helped." TextWrapping="Wrap" Foreground="#F1C66F" VerticalAlignment="Center"/>
    <Grid Grid.Row="1" Margin="0,18,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="75"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Reference URL (https://...)"/><TextBox x:Name="txtLink" Grid.Row="1" Margin="0,8"/><ListBox x:Name="lstLinks" Grid.Row="2"/>
    <WrapPanel Grid.Row="3" Margin="0,12"><Button Content="Add link" Click="AddLink_Click"/><Button Content="Open selected link" Click="OpenLink_Click"/></WrapPanel>
    <TextBlock Grid.Row="4" Text="Session notes"/><TextBox x:Name="txtNotes" Grid.Row="5" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8"/></Grid></Grid>
   </Grid></Border>
  </Grid>
  <StackPanel Grid.Row="2"><WrapPanel>
   <!-- An image inside a button does not change how Click works. -->
   <Button Click="Image_Click"><StackPanel Orientation="Horizontal"><Image x:Name="imgButton" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="Choose artwork" VerticalAlignment="Center"/></StackPanel></Button>
   <Button Content="Export notes" Click="Save_Click"/><Button Content="Reopen text" Click="Open_Click"/>
  </WrapPanel><TextBlock x:Name="txtStatus" Text="Raw starter: follow the tutorial to add each behavior." Foreground="#95E6EF" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>