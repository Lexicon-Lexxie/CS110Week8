<Window x:Class="MusicReferenceHub.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MusicReferenceHub"
 Title="Music Reference Hub - Winamp" Width="1110" Height="810" MinWidth="640" MinHeight="470"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="#0B0B12" Foreground="#EDF8FA" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <!-- XAML builds the visible window. C# adds the actions. Keep x:Class matched to the namespace. -->
 <!-- Classic Winamp 2.x look: borderless window, metal panels, LED time, spectrum bars, green-on-black playlist. -->
 <Window.Resources>

  <!-- ===== Palette ===== -->
  <LinearGradientBrush x:Key="WaBody" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#5A5A72" Offset="0"/><GradientStop Color="#34344A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaFrameBrush" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#B4B4CC" Offset="0"/><GradientStop Color="#15151F" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaInset" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#10101A" Offset="0"/><GradientStop Color="#8C8CA6" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaTitleBrush" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#6E7CA0" Offset="0"/><GradientStop Color="#232B47" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaFace" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#D6DAE8" Offset="0"/><GradientStop Color="#8A8EA4" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaFacePressed" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#7A7E94" Offset="0"/><GradientStop Color="#B6BACE" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaTextFace" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#70748A" Offset="0"/><GradientStop Color="#454960" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaBevelLight" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#F2F4FC" Offset="0"/><GradientStop Color="#2E2E40" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaBevelDark" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#2E2E40" Offset="0"/><GradientStop Color="#C8CCDC" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaVolGroove" StartPoint="0,0" EndPoint="1,0">
   <GradientStop Color="#18B018" Offset="0"/><GradientStop Color="#D8C418" Offset="0.6"/><GradientStop Color="#E02A1A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaBarBrush" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#E02A1A" Offset="0"/><GradientStop Color="#E8C41C" Offset="0.4"/><GradientStop Color="#1CC81C" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WaEqGroove" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#E02A1A" Offset="0"/><GradientStop Color="#D8C418" Offset="0.5"/><GradientStop Color="#18B018" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="WaGroove" Color="#14141E"/>
  <SolidColorBrush x:Key="WaGreen" Color="#00E000"/>
  <SolidColorBrush x:Key="WaLed" Color="#00E200"/>
  <SolidColorBrush x:Key="WaPlate" Color="#232B47"/>
  <SolidColorBrush x:Key="WaGreenDim" Color="#18A018"/>
  <SolidColorBrush x:Key="WaLabel" Color="#AFC0E0"/>
  <SolidColorBrush x:Key="WaGold" Color="#F1C66F"/>
  <DrawingBrush x:Key="WaStripes" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Viewbox="0,0,4,3" ViewboxUnits="Absolute">
   <DrawingBrush.Drawing>
    <DrawingGroup>
     <GeometryDrawing Brush="#1B2236"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,3"/></GeometryDrawing.Geometry></GeometryDrawing>
     <GeometryDrawing Brush="#8E9CC4"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,1"/></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup>
   </DrawingBrush.Drawing>
  </DrawingBrush>

  <local:PlaylistNameConverter x:Key="PlaylistNameConv"/>
  <local:CurrentTrackBrushConverter x:Key="CurrentTrackConv"/>

  <!-- ===== Panels ===== -->
  <Style x:Key="WaFrame" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource WaBody}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource WaFrameBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="WaWell" TargetType="Border">
   <Setter Property="Background" Value="#000000"/>
   <Setter Property="BorderBrush" Value="{DynamicResource WaInset}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- ===== Buttons ===== -->
  <Style x:Key="WaBtn" TargetType="Button">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Background" Value="{DynamicResource WaFace}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WaBevelLight}" BorderThickness="1" CornerRadius="1">
       <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WaFacePressed}"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WaBevelDark}"/>
        <Setter TargetName="Cp" Property="Margin" Value="1,1,0,0"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="WaTitleBtn" TargetType="Button" BasedOn="{StaticResource WaBtn}">
   <Setter Property="Width" Value="9"/>
   <Setter Property="Height" Value="9"/>
   <Setter Property="Margin" Value="0,0,2,0"/>
  </Style>

  <!-- Implicit style: every plain text button in the app gets the Winamp look. -->
  <Style TargetType="Button">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="FontFamily" Value="Arial"/>
   <Setter Property="FontSize" Value="9"/>
   <Setter Property="Foreground" Value="#E6EAF6"/>
   <Setter Property="Background" Value="{DynamicResource WaTextFace}"/>
   <Setter Property="Padding" Value="8,2"/>
   <Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WaBevelLight}" BorderThickness="1" CornerRadius="1" Padding="{TemplateBinding Padding}">
       <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#34374A"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WaBevelDark}"/>
        <Setter TargetName="Cp" Property="Margin" Value="1,1,0,0"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="WaToggle" TargetType="ToggleButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="FontFamily" Value="Arial"/>
   <Setter Property="FontSize" Value="8"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Foreground" Value="#8E92AA"/>
   <Setter Property="Background" Value="#3A3C50"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WaBevelLight}" BorderThickness="1" CornerRadius="1">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource WaGreen}"/>
        <Setter TargetName="Bd" Property="Background" Value="#202233"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WaBevelDark}"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- ===== Sliders (seek, volume, balance) ===== -->
  <Style x:Key="WaTransparentRepeat" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WaThumb" TargetType="Thumb">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Thumb">
      <Border Background="{DynamicResource WaFace}" BorderBrush="{DynamicResource WaBevelLight}" BorderThickness="1" CornerRadius="1"/>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WaSlider" TargetType="Slider">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Background" Value="{DynamicResource WaGroove}"/>
   <Setter Property="Tag" Value="14"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
       <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WaInset}" BorderThickness="1"/>
       <Track x:Name="PART_Track">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource WaTransparentRepeat}"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource WaTransparentRepeat}"/>
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
         <Thumb Style="{StaticResource WaThumb}" Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
        </Track.Thumb>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="WaVSlider" TargetType="Slider">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Orientation" Value="Vertical"/>
   <Setter Property="Background" Value="{DynamicResource WaEqGroove}"/>
   <Setter Property="Tag" Value="9"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
       <Border Width="5" HorizontalAlignment="Center" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WaInset}" BorderThickness="1"/>
       <Track x:Name="PART_Track">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource WaTransparentRepeat}"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource WaTransparentRepeat}"/>
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
         <Thumb Style="{StaticResource WaThumb}" Height="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
        </Track.Thumb>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- ===== Text boxes, lists, scrollbars ===== -->
  <Style TargetType="TextBox">
   <Setter Property="FontFamily" Value="Arial"/>
   <Setter Property="FontSize" Value="9"/>
   <Setter Property="Background" Value="#000000"/>
   <Setter Property="Foreground" Value="{DynamicResource WaGreen}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource WaGreen}"/>
   <Setter Property="SelectionBrush" Value="#0000C6"/>
   <Setter Property="Padding" Value="3,2"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WaInset}" BorderThickness="1" Padding="{TemplateBinding Padding}">
       <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="ListBox">
   <Setter Property="FontFamily" Value="Arial"/>
   <Setter Property="FontSize" Value="9"/>
   <Setter Property="Background" Value="#000000"/>
   <Setter Property="Foreground" Value="{DynamicResource WaGreen}"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WaInset}" BorderThickness="1">
       <ScrollViewer Focusable="False" Padding="1"><ItemsPresenter/></ScrollViewer>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource WaGreen}"/>
   <Setter Property="Padding" Value="3,1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#0000C6"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="9"/>
   <Setter Property="MinWidth" Value="9"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ScrollBar">
      <Border Background="#14141E">
       <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource WaTransparentRepeat}"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource WaTransparentRepeat}"/>
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
         <Thumb Style="{StaticResource WaThumb}"/>
        </Track.Thumb>
       </Track>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <!-- The skin is designed at 609 x 438. It is scaled to fit the window; any extra room goes to the playlist, notes and reference panel. -->
 <Grid x:Name="outer" ClipToBounds="True" SizeChanged="Outer_SizeChanged">
  <Grid x:Name="scaleHost" HorizontalAlignment="Left" VerticalAlignment="Top" TextElement.FontFamily="Arial" TextElement.FontSize="9" TextElement.Foreground="{DynamicResource WaLabel}">
   <Grid.LayoutTransform><ScaleTransform x:Name="uiScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
   <Grid.ColumnDefinitions><ColumnDefinition Width="275"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*" MinWidth="330"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="4"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="4"/><RowDefinition Height="14"/></Grid.RowDefinitions>

   <!-- ================= MAIN PLAYER WINDOW ================= -->
   <Border x:Name="mainFrame" Grid.Row="0" Grid.Column="0" Height="116" ClipToBounds="True" Style="{StaticResource WaFrame}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>

     <!-- Title bar: drag to move the window -->
     <Border x:Name="mainTitleBar" Background="{DynamicResource WaTitleBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
      <Grid>
       <Rectangle Fill="{DynamicResource WaStripes}" Margin="3,3,3,3"/>
       <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource WaPlate}" Padding="6,0">
        <TextBlock x:Name="txtMainTitle" Text="WINAMP" FontWeight="Bold" FontSize="8" Foreground="#D8E0F4"/>
       </Border>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
        <Button Style="{StaticResource WaTitleBtn}" Click="Minimize_Click" ToolTip="Minimize">
         <Path Data="M0,0 H5" Stroke="#101018" StrokeThickness="1.6" Margin="0,3,0,0"/>
        </Button>
        <Button Style="{StaticResource WaTitleBtn}" Click="Shade_Click" ToolTip="Windowshade mode (double-click the title bar)">
         <Path Data="M0,0 H5 M0,2.5 H5" Stroke="#101018" StrokeThickness="1.2" Margin="0,1,0,0"/>
        </Button>
        <Button Style="{StaticResource WaTitleBtn}" Click="Close_Click" ToolTip="Close">
         <Path Data="M0,0 L5,5 M5,0 L0,5" Stroke="#101018" StrokeThickness="1.3"/>
        </Button>
       </StackPanel>
      </Grid>
     </Border>

     <Canvas Grid.Row="1">
      <!-- Left display: LED clock, play state, spectrum analyzer -->
      <Border Style="{StaticResource WaWell}" Canvas.Left="6" Canvas.Top="3" Width="104" Height="42">
       <Canvas>
        <local:LedTime x:Name="ledTime" Canvas.Left="6" Canvas.Top="4" Height="13" Text="00:00" LitBrush="{DynamicResource WaLed}" Cursor="Hand" ToolTip="Click to switch between elapsed and remaining time" MouseLeftButtonDown="LedTime_MouseDown"/>
        <TextBlock x:Name="txtPlayState" Canvas.Left="86" Canvas.Top="4" Text="&#x25A0;" FontSize="9" Foreground="{DynamicResource WaGreen}"/>
        <ItemsControl x:Name="eqSliders" Canvas.Left="6" Canvas.Top="22" Width="76" Height="16">
         <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
           <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
         </ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Border Width="3" Height="{Binding}" Margin="0,0,1,0" VerticalAlignment="Bottom" ClipToBounds="True">
            <Rectangle Height="16" VerticalAlignment="Bottom" Fill="{DynamicResource WaBarBrush}"/>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Polyline x:Name="scopeLine" Canvas.Left="6" Canvas.Top="22" Stroke="{DynamicResource WaGreen}" StrokeThickness="1" Visibility="Collapsed"/>
        <Rectangle x:Name="visHit" Canvas.Left="6" Canvas.Top="22" Width="76" Height="16" Fill="Transparent" Cursor="Hand" ToolTip="Click to change the visualization" MouseLeftButtonDown="Visualizer_MouseDown"/>
       </Canvas>
      </Border>

      <!-- Right display: scrolling track title and position -->
      <Border Style="{StaticResource WaWell}" Canvas.Left="114" Canvas.Top="3" Width="153" Height="42">
       <Canvas>
        <Canvas x:Name="marqueeHost" Canvas.Left="5" Canvas.Top="5" Width="141" Height="12" ClipToBounds="True">
         <TextBlock x:Name="txtNowPlaying" Text="No local file loaded" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource WaGreen}" TextWrapping="NoWrap">
          <TextBlock.RenderTransform><TranslateTransform x:Name="marqueeShift"/></TextBlock.RenderTransform>
         </TextBlock>
        </Canvas>
        <TextBlock x:Name="txtAudioInfo" Canvas.Left="5" Canvas.Top="19" Text="" FontSize="8" Foreground="{DynamicResource WaGreenDim}"/>
        <TextBlock x:Name="txtPosition" Canvas.Left="5" Canvas.Top="29" Text="0:00 / 0:00" FontSize="8.5" Foreground="{DynamicResource WaGreenDim}"/>
       </Canvas>
      </Border>

      <!-- Volume, balance, shuffle, repeat -->
      <Slider x:Name="sldVolume" Style="{StaticResource WaSlider}" Canvas.Left="6" Canvas.Top="49" Width="72" Height="11" Tag="14" Background="{DynamicResource WaVolGroove}" Minimum="0" Maximum="1" Value="0.35" ValueChanged="SldVolume_ValueChanged" ToolTip="Volume"/>
      <Slider x:Name="sldBalance" Style="{StaticResource WaSlider}" Canvas.Left="84" Canvas.Top="49" Width="44" Height="11" Tag="14" Background="{DynamicResource WaVolGroove}" Minimum="-1" Maximum="1" Value="0" ValueChanged="SldBalance_ValueChanged" ToolTip="Balance"/>
      <ToggleButton x:Name="btnShuffle" Style="{StaticResource WaToggle}" Canvas.Left="150" Canvas.Top="48" Width="56" Height="13" Content="SHUFFLE" Click="Shuffle_Click"/>
      <ToggleButton x:Name="btnRepeat" Style="{StaticResource WaToggle}" Canvas.Left="210" Canvas.Top="48" Width="57" Height="13" Content="REPEAT" Click="Repeat_Click"/>

      <!-- Seek bar -->
      <Slider x:Name="sldSeek" Style="{StaticResource WaSlider}" Canvas.Left="6" Canvas.Top="64" Width="261" Height="10" Tag="29" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" ValueChanged="SldSeek_ValueChanged" PreviewMouseLeftButtonDown="SldSeek_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="SldSeek_PreviewMouseLeftButtonUp"/>

      <!-- Transport buttons -->
      <Button Style="{StaticResource WaBtn}" Canvas.Left="6" Canvas.Top="78" Width="23" Height="18" Click="Prev_Click" ToolTip="Previous">
       <Path Data="M0,0 H2 V8 H0 Z M9,0 V8 L3,4 Z" Fill="#14141C"/>
      </Button>
      <Button Style="{StaticResource WaBtn}" Canvas.Left="29" Canvas.Top="78" Width="23" Height="18" Click="Play_Click" ToolTip="Play">
       <Path Data="M0,0 L8,5 L0,10 Z" Fill="#14141C"/>
      </Button>
      <Button Style="{StaticResource WaBtn}" Canvas.Left="52" Canvas.Top="78" Width="23" Height="18" Click="Pause_Click" ToolTip="Pause">
       <Path Data="M0,0 H3 V9 H0 Z M5,0 H8 V9 H5 Z" Fill="#14141C"/>
      </Button>
      <Button Style="{StaticResource WaBtn}" Canvas.Left="75" Canvas.Top="78" Width="23" Height="18" Click="Stop_Click" ToolTip="Stop">
       <Path Data="M0,0 H8 V8 H0 Z" Fill="#14141C"/>
      </Button>
      <Button Style="{StaticResource WaBtn}" Canvas.Left="98" Canvas.Top="78" Width="23" Height="18" Click="Next_Click" ToolTip="Next">
       <Path Data="M0,0 L6,4 L0,8 Z M7,0 H9 V8 H7 Z" Fill="#14141C"/>
      </Button>
      <Button Style="{StaticResource WaBtn}" Canvas.Left="125" Canvas.Top="78" Width="22" Height="18" Click="Load_Click" ToolTip="Load audio">
       <Path Data="M0,6 L4.5,0 L9,6 Z M0,7.5 H9 V9.5 H0 Z" Fill="#14141C"/>
      </Button>
      <ToggleButton x:Name="btnEqualizer" Style="{StaticResource WaToggle}" Canvas.Left="152" Canvas.Top="78" Width="115" Height="18" FontSize="9" Content="EQUALIZER" Click="Equalizer_Click" ToolTip="Show or hide the equalizer"/>
     </Canvas>
    </Grid>
   </Border>

   <!-- ================= EQUALIZER WINDOW (slides out under the player) ================= -->
   <Border x:Name="eqHost" Grid.Row="2" Grid.Column="0" Height="0" ClipToBounds="True">
    <Border Style="{StaticResource WaFrame}" Height="116" VerticalAlignment="Top">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource WaTitleBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
       <Grid>
        <Rectangle Fill="{DynamicResource WaStripes}" Margin="3,3,3,3"/>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource WaPlate}" Padding="6,0">
         <TextBlock Text="WINAMP EQUALIZER" FontWeight="Bold" FontSize="8" Foreground="#D8E0F4"/>
        </Border>
        <Button Style="{StaticResource WaTitleBtn}" HorizontalAlignment="Right" Margin="0,0,5,0" Click="EqClose_Click" ToolTip="Hide equalizer">
         <Path Data="M0,0 L5,5 M5,0 L0,5" Stroke="#101018" StrokeThickness="1.3"/>
        </Button>
       </Grid>
      </Border>
      <Canvas Grid.Row="1">
       <ToggleButton x:Name="btnEqOn" Style="{StaticResource WaToggle}" Canvas.Left="6" Canvas.Top="5" Width="26" Height="13" Content="ON" IsChecked="True" Click="EqOn_Click"/>
       <Border Style="{StaticResource WaWell}" Canvas.Left="76" Canvas.Top="3" Width="118" Height="21">
        <Canvas x:Name="eqGraph">
         <Line X1="2" X2="114" Y1="9.5" Y2="9.5" Stroke="#1E4A1E" StrokeThickness="1"/>
         <Polyline x:Name="eqCurve" Stroke="{DynamicResource WaGreen}" StrokeThickness="1"/>
        </Canvas>
       </Border>
       <Button Canvas.Left="212" Canvas.Top="5" Width="55" Height="13" Padding="0" Margin="0" Content="PRESETS" FontSize="8" Click="EqPresets_Click"/>
       <TextBlock Canvas.Left="4" Canvas.Top="24" Text="+12 dB" FontSize="7"/>
       <TextBlock Canvas.Left="4" Canvas.Top="53" Text="0 dB" FontSize="7"/>
       <TextBlock Canvas.Left="4" Canvas.Top="82" Text="-12 dB" FontSize="7"/>
       <Canvas x:Name="eqBands"/>
      </Canvas>
     </Grid>
    </Border>
   </Border>

   <!-- ================= PLAYLIST EDITOR WINDOW ================= -->
   <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource WaFrame}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource WaTitleBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
      <Grid>
       <Rectangle Fill="{DynamicResource WaStripes}" Margin="3,3,3,3"/>
       <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource WaPlate}" Padding="6,0">
        <TextBlock Text="WINAMP PLAYLIST EDITOR" FontWeight="Bold" FontSize="8" Foreground="#D8E0F4"/>
       </Border>
      </Grid>
     </Border>
     <ListBox x:Name="lstPlaylist" Grid.Row="1" Margin="6,5,6,3" AlternationCount="100000" AllowDrop="True" MouseDoubleClick="LstPlaylist_MouseDoubleClick" DragOver="Playlist_DragOver" Drop="Playlist_Drop">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <TextBlock TextTrimming="CharacterEllipsis">
         <TextBlock.Foreground>
          <MultiBinding Converter="{StaticResource CurrentTrackConv}">
           <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="(ItemsControl.AlternationIndex)"/>
           <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="CurrentIndex"/>
          </MultiBinding>
         </TextBlock.Foreground>
         <TextBlock.Text>
          <MultiBinding Converter="{StaticResource PlaylistNameConv}">
           <Binding/>
           <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="(ItemsControl.AlternationIndex)"/>
          </MultiBinding>
         </TextBlock.Text>
        </TextBlock>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <Grid Grid.Row="2" Margin="6,0,6,5">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="+ ADD" Click="Load_Click" ToolTip="Load audio (or drag files onto the list)"/>
       <Button Content="- REM" Click="Remove_Click" ToolTip="Remove the selected track (Delete key)"/>
       <Button Content="CLR" Click="Clear_Click" ToolTip="Clear the playlist"/>
      </StackPanel>
      <TextBlock x:Name="txtPlaylistInfo" Text="0 items" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource WaGreen}"/>
     </Grid>
    </Grid>
   </Border>

   <!-- ================= REFERENCE WINDOW (links, notes, artwork) ================= -->
   <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Style="{StaticResource WaFrame}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource WaTitleBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
      <Grid>
       <Rectangle Fill="{DynamicResource WaStripes}" Margin="3,3,3,3"/>
       <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource WaPlate}" Padding="6,0">
        <TextBlock Text="MUSIC REFERENCE HUB" FontWeight="Bold" FontSize="8" Foreground="#D8E0F4"/>
       </Border>
      </Grid>
     </Border>

     <Grid Grid.Row="1" Margin="8,6,8,8">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
       <TextBlock Text="TUNE IN  /  TURN IT UP  /  TAKE NOTES" Foreground="{DynamicResource WaGold}" FontSize="8" FontWeight="Bold"/>
       <TextBlock Text="Music Reference Hub" FontSize="18" FontWeight="Bold" Foreground="#EAF0FF" Margin="0,2,0,0"/>
       <!-- TODO: add your user and story context to this subtitle. -->
       <TextBlock Text="Load a track. Stash the links. Write down what moved you." Foreground="{DynamicResource WaLabel}" Margin="0,0,0,6"/>
      </StackPanel>

      <!-- Artwork + intro -->
      <Grid Grid.Row="1" Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource WaWell}" Width="110" Height="90" HorizontalAlignment="Left">
        <Grid>
         <TextBlock Text="NO ARTWORK" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Foreground="#1E4A1E"/>
         <!-- TODO: load your PNG/JPG into these named images in the Artwork chapter. -->
         <Image x:Name="imgArtwork" Stretch="Uniform"/>
        </Grid>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Top">
        <TextBlock Text="Drop in some tunes, save your favorite references, and jot down what hits." TextWrapping="Wrap" Foreground="{DynamicResource WaGold}"/>
        <!-- An image inside a button does not change how Click works. -->
        <Button Click="Image_Click" HorizontalAlignment="Left" Margin="0,8,0,0">
         <StackPanel Orientation="Horizontal"><Image x:Name="imgButton" Width="14" Height="14" Margin="0,0,5,0"/><TextBlock Text="CHOOSE ARTWORK" VerticalAlignment="Center"/></StackPanel>
        </Button>
       </StackPanel>
      </Grid>

      <TextBlock Grid.Row="2" Text="Reference URL (https://...)"/>
      <TextBox x:Name="txtLink" Grid.Row="3" Margin="0,3,0,5"/>
      <ListBox x:Name="lstLinks" Grid.Row="4" Height="70" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      <WrapPanel Grid.Row="5" Margin="0,6,0,6">
       <Button Content="ADD LINK" Click="AddLink_Click"/>
       <Button Content="OPEN SELECTED LINK" Click="OpenLink_Click"/>
      </WrapPanel>
      <Grid Grid.Row="6">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="Session notes"/>
       <TextBox x:Name="txtNotes" Grid.Row="1" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,3,0,0"/>
      </Grid>
      <WrapPanel Grid.Row="7" Margin="0,6,0,0">
       <Button Content="EXPORT NOTES" Click="Save_Click"/>
       <Button Content="REOPEN TEXT" Click="Open_Click"/>
      </WrapPanel>
     </Grid>
    </Grid>
   </Border>

   <!-- ================= STATUS STRIP ================= -->
   <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource WaWell}">
    <TextBlock x:Name="txtStatus" Text="Raw starter: follow the tutorial to add each behavior." Foreground="{DynamicResource WaGreen}" FontSize="9" Margin="5,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </Border>
  </Grid>
 </Grid>
</Window>
